#!/usr/bin/env node

// Module dependencies.
require('dotenv').config();
const app = require('../app');
const { closeAccessLogStream } = require('../app');
const http = require('http');
const logger = require('../library/logger');
const { closeRedis } = require('../library/cache');
const { closeDatabase } = require('../models');
const sendEmail = require('../library/sendEmail');
const { cleanupAllTempFiles } = require('../components/admin/user/domain/user.controller');

// Get port from environment and store in Express.
const port = normalizePort(process.env.PORT || '3000');

// Create HTTP server.
const server = http.createServer(app);

let shuttingDown = false;

// Listen on provided port, on all network interfaces.
server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

process.on('SIGTERM', () => shutdown('SIGTERM'));
process.on('SIGINT', () => shutdown('SIGINT'));

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

async function shutdown(signal) {
  if (shuttingDown) {
    return;
  }
  shuttingDown = true;

  logger.info({ signal }, 'Shutting down gracefully');

  const timeoutMs = Math.max(
    5000,
    Number(process.env.SHUTDOWN_TIMEOUT_MS || 30000)
  );

  const forceTimer = setTimeout(() => {
    logger.error({ timeoutMs }, 'Forced shutdown after timeout');
    process.exit(1);
  }, timeoutMs);
  forceTimer.unref();

  if (typeof server.closeAllConnections === 'function') {
    server.closeAllConnections();
  }

  server.close(async () => {
    try {
      cleanupAllTempFiles();
      await sendEmail.closeEmailTransport();
      await closeRedis();
      await closeDatabase();
      await closeAccessLogStream();
      clearTimeout(forceTimer);
      logger.info('Shutdown complete');
      process.exit(0);
    } catch (err) {
      clearTimeout(forceTimer);
      logger.error(err, 'Shutdown error');
      process.exit(1);
    }
  });
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
    console.log("Listening on "  + bind)
}

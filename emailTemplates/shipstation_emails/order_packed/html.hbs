<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #f4f6fb;
        }

        .email-container {
            max-width: 600px;
            margin: 30px auto;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(44, 62, 80, 0.10);
            overflow: hidden;
        }

        .header {
            border-radius: 14px;
            border: 1px solid var(--Natural-10, #FFF);
            background: linear-gradient(90deg, #083122 0%, #035335 50%, #083122 100%);
            box-shadow: -1px 4px 24px 0 rgba(0, 0, 0, 0.24);
            padding: 32px 0 16px 0;
            text-align: center;
        }

        .logo {
            max-width: 160px;
            margin-bottom: 10px;
        }

        .content {
            padding: 32px 24px 24px 24px;
        }

        h2 {
            color: #2e8b57;
            margin-bottom: 8px;
            font-size: 28px;
            font-weight: 700;
        }

        .order-details {
            background: #f8fafc;
            border-radius: 12px;
            padding: 24px;
            margin: 24px 0;
            box-shadow: 0 2px 8px rgba(44, 62, 80, 0.04);
        }

        .order-details h3 {
            margin-top: 0;
            color: #222;
            font-size: 20px;
            font-weight: 600;
        }

        .order-details p {
            margin: 6px 0;
            color: #444;
            font-size: 15px;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 18px;
            background: #3498db;
            color: #fff;
            border-radius: 20px;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 1px;
            margin-left: 10px;
            text-transform: capitalize;
        }

        .footer {
            background: #f2f6f9;
            text-align: center;
            padding: 24px 10px;
            color: #888;
            font-size: 13px;
            border-top: 1px solid #e0e6ed;
        }

        @media (max-width: 650px) {
            .email-container {
                margin: 10px;
            }

            .content,
            .order-details {
                padding: 16px;
            }
        }
    </style>
</head>

<body>
    <div class="email-container">
        <div class="header">
            <a href="{{FRONTEND_URL}}">
                <img src="{{host}}/public/images/logo.png" alt="VapeHub Logo" class="logo" />
            </a>
        </div>
        <div class="content">
            <h2>Order Packed & Ready</h2>
            <p style="font-size:16px; color:#222;">Hello {{userName}},</p>
            <p style="font-size:15px; color:#444;">Great news! Your order has been packed and is being prepared for shipment.</p>
            <div class="order-details">
                <h3>Order Summary</h3>
                <p><strong>Order Number:</strong> #{{orderCode}}</p>
                <p><strong>Order ID:</strong> {{orderUniqueId}}</p>
                <p><strong>Order Date:</strong> {{orderDate}}</p>
                <p><strong>Order Status:</strong> <span class="status-badge">{{status}}</span></p>
            </div>
            <div style="margin: 32px 0 0 0; padding: 20px; background: #e8f4fd; border-radius: 10px; color: #2980b9; font-size: 15px;">
                <h3 style="margin-top:0;">What's Next?</h3>
                <p>Your order is now packed and ready. We'll notify you once your package has been shipped with tracking information.</p>
            </div>
        </div>
        <div class="footer">
            <p>Need help with your order? Our customer service team is here to assist you.</p>
            <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #ddd;">
                <p style="font-weight: bold; margin-bottom: 10px;">Customer Services</p>
                <p>Email us: <a href="mailto:customerservices@vapehub.co.uk" style="color: #2e8b57;">customerservices@vapehub.co.uk</a></p>
                <p>Call us: <a href="tel:07508373773" style="color: #2e8b57;">07508 373773</a></p>
            </div>
            <p>&copy; {{currentYear}} VapeHub. All rights reserved.</p>
        </div>
    </div>
</body>

</html>


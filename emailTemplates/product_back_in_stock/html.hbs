<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background: #f3f4f6;
        }
        .email-container {
            max-width: 600px;
            margin: 20px auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
        }
        .header {
            background: #2e8b57;
            padding: 28px 20px;
            text-align: center;
            color: white;
        }
        .content {
            padding: 36px 28px;
            text-align: center;
            color: #374151;
        }
        h2 {
            color: #111827;
            margin: 0 0 12px;
            font-size: 24px;
        }
        p {
            margin: 0 0 18px;
            font-size: 16px;
            line-height: 1.6;
        }
        .product-card {
            background: #f9fafb;
            border-radius: 10px;
            padding: 20px;
            margin: 24px 0;
        }
        .product-image {
            max-width: 180px;
            height: auto;
            border-radius: 8px;
            margin-bottom: 12px;
        }
        .product-name {
            font-size: 18px;
            font-weight: 600;
            color: #111827;
            margin-bottom: 8px;
        }
        .cta {
            display: inline-block;
            background: #2e8b57;
            color: #ffffff !important;
            text-decoration: none;
            padding: 12px 28px;
            border-radius: 8px;
            font-weight: 600;
            margin-top: 8px;
        }
        .footer {
            padding: 20px 28px 28px;
            text-align: center;
            font-size: 13px;
            color: #6b7280;
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <div style="font-size: 28px; font-weight: 700;">VapeHub</div>
            <div style="margin-top: 8px;">It's back in stock</div>
        </div>
        <div class="content">
            <h2>Good news!</h2>
            <p>The product you asked to be notified about is now available.</p>
            <div class="product-card">
                {{#if product.image_url}}
                <img class="product-image" src="{{product.image_url}}" alt="{{product.name}}" />
                {{/if}}
                <div class="product-name">{{product.name}}</div>
                <a class="cta" href="{{FRONTEND_URL}}/product/{{product.slug}}">View product</a>
            </div>
            <p>This is a one-time notification. You will not receive further alerts for this product unless you sign up again.</p>
        </div>
        <div class="footer">
            Customer Services<br />
            Email: customerservices@vapehub.co.uk<br />
            Call: 07508 373773<br /><br />
            © {{currentYear}} VapeHub. All rights reserved.
        </div>
    </div>
</body>
</html>

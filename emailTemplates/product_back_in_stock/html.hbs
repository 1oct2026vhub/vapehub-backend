<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }

        .email-container {
            max-width: 600px;
            margin: 20px auto;
            background-color: #ffffff;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            word-break: break-word;
        }

        .header {
            background: linear-gradient(135deg, #2e8b57 0%, #3cb371 100%);
            padding: 24px 20px;
            text-align: center;
            color: white;
            position: relative;
        }

        .header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="2" fill="rgba(255,255,255,0.1)"/><circle cx="80" cy="40" r="1.5" fill="rgba(255,255,255,0.1)"/><circle cx="40" cy="80" r="1" fill="rgba(255,255,255,0.1)"/></svg>');
            opacity: 0.3;
        }

        .logo {
            max-width: 140px;
            height: auto;
            position: relative;
            z-index: 1;
        }

        .header-tagline {
            margin-top: 12px;
            font-size: 18px;
            font-weight: 600;
            position: relative;
            z-index: 1;
        }

        .content {
            padding: 36px 30px;
            text-align: left;
        }

        h1 {
            color: #2e8b57;
            margin: 0 0 16px;
            font-size: 28px;
            line-height: 1.3;
        }

        p {
            color: #4a5568;
            margin: 0 0 18px;
            font-size: 16px;
            line-height: 1.6;
        }

        .product-card {
            background: #f8fafc;
            border-radius: 12px;
            padding: 24px;
            margin: 28px 0;
            text-align: center;
            border: 1px solid #e2e8f0;
        }

        .product-image {
            max-width: 180px;
            max-height: 180px;
            width: auto;
            height: auto;
            border-radius: 10px;
            margin: 0 auto 16px;
            display: block;
        }

        .product-name {
            font-size: 20px;
            font-weight: 700;
            color: #1a202c;
            margin-bottom: 12px;
        }

        .price-row {
            margin-bottom: 20px;
        }

        .price-current {
            font-size: 22px;
            font-weight: 700;
            color: #2e8b57;
        }

        .price-original {
            font-size: 16px;
            color: #a0aec0;
            text-decoration: line-through;
            margin-left: 8px;
        }

        .cta-button {
            display: inline-block;
            padding: 14px 32px;
            background: linear-gradient(135deg, #2e8b57 0%, #3cb371 100%);
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 25px;
            font-weight: 600;
            font-size: 16px;
            box-shadow: 0 4px 15px rgba(46, 139, 87, 0.3);
        }

        .notice {
            background: #f7fafc;
            border-left: 4px solid #2e8b57;
            border-radius: 8px;
            padding: 16px 18px;
            margin-top: 24px;
            font-size: 14px;
            color: #718096;
        }

        .trust-line {
            text-align: center;
            font-size: 14px;
            color: #718096;
            margin-top: 8px;
        }

        .footer {
            background: #2d3748;
            color: #ffffff;
            padding: 28px 24px;
            text-align: center;
        }

        .footer p {
            color: #cbd5e0;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .footer a {
            color: #63b3ed;
            text-decoration: none;
        }

        @media only screen and (max-width: 600px) {
            .content {
                padding: 28px 20px;
            }

            h1 {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="header">
            <a href="{{FRONTEND_URL}}">
                <img src="{{host}}/public/images/logo.png" alt="VapeHub Logo" class="logo" width="140" style="max-width:140px;height:auto;display:block;margin:0 auto;" />
            </a>
            <div class="header-tagline">It's back in stock</div>
        </div>

        <div class="content">
            <h1>Get this product first — {{product.name}} is now available</h1>
            <p>You asked us to let you know when this product was available. It's in stock now, so order before it sells out again.</p>

            <div class="product-card">
                {{#if product.image_url}}
                <img class="product-image" src="{{product.image_url}}" alt="{{product.name}}" width="180" style="max-width:180px;height:auto;display:block;margin:0 auto 16px;" />
                {{/if}}
                <div class="product-name">{{product.name}}</div>
                {{#if product.display_price}}
                <div class="price-row">
                    <span class="price-current">£{{product.display_price}}</span>
                    {{#if product.has_discount}}
                    <span class="price-original">£{{product.original_price}}</span>
                    {{/if}}
                </div>
                {{/if}}
                <a href="{{product.url}}" class="cta-button">Shop now</a>
            </div>
            <div class="notice">
                This is a one-time notification for this product. You will not receive further alerts unless you sign up again on the product page.
            </div>
        </div>

        <div class="footer">
            <p>Thank you for shopping with VapeHub.</p>
            <p style="font-weight: bold; color: #ffffff; margin-bottom: 8px;">Customer Services</p>
            <p>Email us: <a href="mailto:customerservices@vapehub.co.uk">customerservices@vapehub.co.uk</a></p>
            <p>Call us: <a href="tel:07508373773">07508 373773</a></p>
            <p style="margin-top: 16px;">&copy; {{currentYear}} VapeHub. All rights reserved.</p>
        </div>
    </div>
</body>
</html>

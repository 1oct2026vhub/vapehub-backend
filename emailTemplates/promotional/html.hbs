<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }

        /* Constrain all images in the email - keep promotional images small */
        .email-container img {
            max-width: 280px;
            max-height: 180px;
            height: auto;
            width: 100%;
            display: block;
            margin-left: auto;
            margin-right: auto;
        }

        .email-container {
            max-width: 600px;
            margin: 20px auto;
            background-color: #ffffff;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

        .header {
            background: linear-gradient(135deg, #2e8b57 0%, #3cb371 100%);
            padding: 16px 20px;
            text-align: center;
            color: white;
            position: relative;
        }

        .header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="2" fill="rgba(255,255,255,0.1)"/><circle cx="80" cy="40" r="1.5" fill="rgba(255,255,255,0.1)"/><circle cx="40" cy="80" r="1" fill="rgba(255,255,255,0.1)"/></svg>');
            opacity: 0.3;
        }

        .logo {
            max-width: 140px;
            width: 140px;
            height: auto;
            margin: 0;
            position: relative;
            z-index: 1;
        }

        .promo-icon {
            font-size: 28px;
            margin: 6px 0 0 0;
            position: relative;
            z-index: 1;
        }

        .content {
            padding: 40px 30px;
            text-align: left;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

        h1 {
            color: #2d3748;
            margin-bottom: 20px;
            font-size: 32px;
            font-weight: 700;
        }

        h2 {
            color: #2e8b57;
            margin-bottom: 15px;
            font-size: 24px;
        }

        p {
            color: #4a5568;
            margin-bottom: 20px;
            font-size: 16px;
            line-height: 1.6;
            text-align: left;
        }

        .promo-content {
            background: #f8fafc;
            border-radius: 12px;
            padding: 30px;
            margin: 30px 0;
            border-left: 4px solid #2e8b57;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

        .promo-content h3 {
            color: #2e8b57;
            margin-bottom: 15px;
            font-size: 20px;
        }

        .cta-section {
            margin: 40px 0 20px 0;
            padding: 30px;
            background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
            border-radius: 12px;
        }

        .cta-button {
            display: inline-block;
            padding: 15px 30px;
            background: linear-gradient(135deg, #2e8b57 0%, #3cb371 100%);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 16px;
            transition: transform 0.2s ease;
            margin: 10px;
        }

        .cta-button:hover {
            transform: translateY(-1px);
        }

        .secondary-button {
            background: linear-gradient(135deg, #718096 0%, #4a5568 100%);
        }

        .footer {
            background: #2d3748;
            color: white;
            padding: 30px 20px;
            text-align: center;
        }

        .footer p {
            margin: 8px 0;
            color: #a0aec0;
            text-align: center;
        }

        .unsubscribe-link {
            color: #63b3ed;
            text-decoration: none;
        }

        .unsubscribe-link:hover {
            text-decoration: underline;
        }

        .highlight {
            background: linear-gradient(135deg, #649580 0%, #649580 100%);
            padding: 20px;
            border-radius: 8px;
            margin: 20px 0;
            border: 2px solid #649580;
        }

        .highlight h4 {
            color: #ffffff;
            margin-bottom: 10px;
            font-size: 18px;
        }

        .highlight .highlight-text {
            font-weight: bold;
            font-size: 18px;
            color: #ffffff;
            line-height: 1.6;
            margin: 0 0 10px 0;
            display: block;
            text-align: center;
        }

        .highlight-text {
            font-weight: bold;
            font-size: 18px;
            color: #649580;
            line-height: 1.6;
            margin: 0 0 10px 0;
            display: block;
            text-align: center;
        }

        .promo-images-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 15px;
            max-width: 100%;
        }

        .promo-image-item {
            flex: 1;
            min-width: 160px;
            max-width: 220px;
            margin-bottom: 15px;
        }

        .promo-image {
            width: 100%;
            max-width: 220px;
            height: auto;
            max-height: 200px;
            object-fit: contain;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 10px;
            display: block;
        }

        @media (max-width: 650px) {
            .email-container {
                margin: 10px;
            }

            .content {
                padding: 20px;
            }

            .promo-content {
                padding: 20px;
            }

            h1 {
                font-size: 24px;
            }

            h2 {
                font-size: 20px;
            }

            /* Mobile image adjustments - keep images compact */
            .promo-content img {
                max-width: 100% !important;
                max-height: 180px !important;
                width: 100% !important;
                height: auto !important;
            }

            .promo-content>div>div {
                min-width: 100% !important;
                max-width: 100% !important;
                margin-bottom: 20px !important;
            }
        }

        @media (max-width: 480px) {
            .promo-content img {
                max-height: 160px !important;
            }
        }
    </style>
</head>

<body>
    <div class="email-container">
        <div class="header">
            <a href="{{FRONTEND_URL}}">
                <img src="{{host}}/public/images/logo.png" alt="VapeHub Logo" class="logo" width="140" style="max-width:140px;height:auto;" />
            </a>
            <div class="promo-icon">🎉</div>
        </div>

        <div class="content">
            <h1>{{subject}}</h1>

            {{#if highlightText}}
            <div class="highlight">
                <h4>🎯 Special Offer!</h4>
                <p class="highlight-text">{{highlightText}}</p>
            </div>
            {{/if}}

            <!-- Promotional Images -->
            {{#if images}}
            <div class="promo-content" style="margin-bottom: 30px;">
                <h3>🖼️ Promotional Images</h3>
                <div class="promo-images-container">
                    {{#each images}}
                    <div class="promo-image-item">
                        <img src="{{url}}" alt="{{alt}}" class="promo-image" width="220" height="200" style="max-width:220px;max-height:200px;height:auto;width:100%;" />
                        {{#if alt}}
                        <p style="font-size: 14px; color: #666; font-style: italic; text-align: center; margin: 0;">
                            {{alt}}</p>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
            </div>
            {{/if}}

            <div class="promo-content">
                <h3>📢 Promotional Message</h3>
                <div>{{{content}}}</div>
            </div>

            {{#if ctaText}}
            <div class="cta-section">
                <h3 style="color: #2e8b57; margin-bottom: 15px;">Don't Miss Out!</h3>
                <p class="highlight-text">{{ctaText}}</p>
                {{#if ctaUrl}}
                <a href="{{ctaUrl}}" class="cta-button">Shop Now</a>
                {{/if}}
                <a href="{{FRONTEND_URL}}/shop" class="cta-button secondary-button">Browse All Products</a>
            </div>
            {{/if}}

            {{#unless ctaText}}
            <div class="cta-section">
                <h3 style="color: #2e8b57; margin-bottom: 15px;">Ready to Shop?</h3>
                <p style="color: #666; margin-bottom: 20px;">Explore our amazing collection of vaping products!</p>
                <a href="{{FRONTEND_URL}}/shop" class="cta-button">Shop Now</a>
            </div>
            {{/unless}}
        </div>

        <div class="footer">
            <p>Thank you for being a valued VapeHub customer!</p>
            <p>If you have any questions, feel free to contact our support team.</p>
            <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #4a5568;">
                <p style="font-weight: bold; margin-bottom: 10px; color: #ffffff;">Customer Services</p>
                <p style="color: #a0aec0;">Email us: <a href="mailto:customerservices@vapehub.co.uk" style="color: #63b3ed;">customerservices@vapehub.co.uk</a></p>
                <p style="color: #a0aec0;">Call us: <a href="tel:07508373773" style="color: #63b3ed;">07508 373773</a></p>
            </div>
            {{!--
            <p style="margin-top: 20px;">
                <a href="{{FRONTEND_URL}}/unsubscribe?email={{email}}" class="unsubscribe-link">Unsubscribe from
                    promotional emails</a>
            </p>
            --}}
            <p>&copy; {{currentYear}} Vapehub.All rights reserved.</p>
        </div>
    </div>
</body>

</html>
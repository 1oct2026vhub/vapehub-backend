<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f5f5f5;
    }

    .email-container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      background-color: #ffffff;
    }

    .header {
      border-radius: 14px;
      border: 1px solid var(--Natural-10, #FFF);
      background: var(--Primery-Gradient-Radial-01, radial-gradient(30160.52% 49.96% at 50.04% 81.04%, #035335 0%, #083122 100%));

      /* ads */
      box-shadow: -1px 4px 24px 0 rgba(0, 0, 0, 0.24);
      padding: 15px;
      text-align: center;
      color: white;
    }

    .logo {
      max-width: 200px;
      height: auto;
      margin: 10px 0;
    }

    .content {
      padding: 30px 20px;
      text-align: center;
    }

    .button {
      display: inline-block;
      padding: 12px 30px;
      border-radius: 2.89px;
      background: linear-gradient(90deg, #083122 0%, #035335 50%, #083122 100%);
      /* Search bar shadow */
      box-shadow: 0 0 8px 0 rgba(0, 0, 0, 0.11);
      color: white;
      text-decoration: none;
      border-radius: 5px;
      margin: 20px 0;
      font-weight: bold;
    }

    .footer {
      text-align: center;
      padding: 20px;
      color: #666;
      font-size: 12px;
    }

    .referral-code {
      margin: 20px 0;
      font-size: 18px;
      font-weight: bold;
      color: #005434
      background-color: #f0f0f0;
      padding: 10px;
      border-radius: 5px;
      display: inline-block;
    }

    .steps {
      text-align: left;
      margin-top: 30px;
      background-color: #f9f9f9;
      padding: 20px;
      border-radius: 10px;
    }

    .steps h3 {
      color: #2e8b57;
    }

    .steps ol {
      padding-left: 20px;
      line-height: 1.8;
    }
  </style>
</head>

<body>
  <div class="email-container">
    <div class="header">
      <a href="{{FRONTEND_URL}}" style="text-decoration: none; color: white;">
        <img src="{{logoBase64}}" alt="VapeHub Logo" class="logo" />
      </a>
    </div>

    <div class="content">
      <h2>You've Been Invited to Join VapeHub!</h2>

      <p>
        Hi there!<br />
        {{emailContent1}}<br />
        {{emailContent2}}
      </p>

      {{#if token}}
      <div class="referral-code">Your Referral Code: <strong>{{token}}</strong></div>
      {{/if}}

      <a href="{{referralLink}}" target="_blank" class="button">Join & Get Your Discount</a>

      {{#if emailContent2}}
      <div class="steps">
        <h3>How to Claim Your Referral Reward:</h3>
        <ol>
          <li>Click the "Join" button above or visit our registration page.</li>
          <li>Fill in your email and password to create a free account.</li>
          <li>Paste the referral code in the Coupon Code area at checkout to get your discount!</li>
        </ol>
      </div>
      {{else}}
      <div class="steps">
        <h3>How to Create Your VapeHub Account:</h3>
        <ol>
          <li>Click the "Join" button above or go to our registration page.</li>
          <li>Fill in your email and create a secure password.</li>
          <li>Start shopping and enjoy our exclusive products!</li>
        </ol>
      </div>
      {{/if}}

      <p>Thanks for joining our community. Happy vaping! 💨</p>
    </div>

    <div class="footer">
      <p>&copy; {{currentYear}} VapeHub. All rights reserved.</p>
      <p>If you have any questions, feel free to contact us.</p>
    </div>
  </div>
</body>

</html>